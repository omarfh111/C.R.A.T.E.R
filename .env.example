VITE_TELEMETRY_MODE=MOCK
# Set mode to LIVE and provide a canonical JSON WebSocket endpoint for Member 2.
# VITE_TELEMETRY_WS_URL=ws://127.0.0.1:8765/telemetry

# Optional deterministic mock controls (ticks are VITE_MOCK_INTERVAL_MS long).
# VITE_MOCK_INTERVAL_MS=1000
# VITE_MOCK_SEED=7
# VITE_MOCK_TOTAL_TICKS=3600
# VITE_MOCK_LATENCY_TICKS=1
# VITE_MOCK_LOSS_EVERY=9
# VITE_MOCK_DUPLICATE_EVERY=13
# VITE_MOCK_REORDER_EVERY=11
# VITE_MOCK_BLACKOUT_START_TICK=20
# VITE_MOCK_BLACKOUT_DURATION_TICKS=5
