VITE_TELEMETRY_MODE=MOCK
# Set LIVE for the local M2 WebSocket bridge.
# VITE_TELEMETRY_WS_URL=ws://127.0.0.1:8765/telemetry

# Optional deterministic Mission Control mock controls.
# VITE_MOCK_INTERVAL_MS=1000
# VITE_MOCK_SEED=7
# VITE_MOCK_TOTAL_TICKS=3600
# VITE_MOCK_LATENCY_TICKS=1
# VITE_MOCK_LOSS_EVERY=9
# VITE_MOCK_DUPLICATE_EVERY=13
# VITE_MOCK_REORDER_EVERY=11
# VITE_MOCK_BLACKOUT_START_TICK=20
# VITE_MOCK_BLACKOUT_DURATION_TICKS=5

# Optional hosted M1 experiment. Not used by the local end-to-end system.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_PROVIDER=deepinfra
HF_TIMEOUT_SECONDS=45
HF_MAX_SIDE=960
HF_MAX_TOKENS=768
HF_MAX_REQUESTS=100
